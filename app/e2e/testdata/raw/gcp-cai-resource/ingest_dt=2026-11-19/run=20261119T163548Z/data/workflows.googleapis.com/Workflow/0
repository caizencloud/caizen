{"name":"//workflows.googleapis.com/projects/ln-prod-automation/locations/us-central1/workflows/cai-export","asset_type":"workflows.googleapis.com/Workflow","resource":{"version":"v1","discovery_document_uri":"https://workflows.googleapis.com/$discovery/rest","discovery_name":"Workflow","parent":"//cloudresourcemanager.googleapis.com/projects/459462137144","data":{"callLogLevel":"LOG_ERRORS_ONLY","createTime":"2026-11-19T16:11:02.681101401Z","description":"Exports Cloud Asset Inventory snapshots of organizations/684587186245 to gs://ln-prod-automation-caizen-data/raw/gcp-cai-*/","labels":{"goog-terraform-provisioned":"true","owner":"seceng"},"name":"projects/ln-prod-automation/locations/us-central1/workflows/cai-export","revisionCreateTime":"2026-11-19T16:19:23.177747715Z","revisionId":"000002-baf","serviceAccount":"projects/ln-prod-automation/serviceAccounts/cai-export-sa@ln-prod-automation.iam.gserviceaccount.com","sourceContents":"# Exports Cloud Asset Inventory snapshots to the Caizen data bucket.\n#\n# One execution exports every configured content type in parallel, all at\n# the same readTime. Each content type is its own feed:\n#\n#   raw/<feed>/ingest_dt=<arrival date>/run=<readTime>/data/<ASSET_TYPE>/<shard>\n#   raw/<feed>/ingest_dt=<arrival date>/run=<readTime>/_meta.json\n#   raw/<feed>/ingest_dt=<arrival date>/run=<readTime>/_SUCCESS\n#\n# _SUCCESS is written last. A feed whose export fails gets no _SUCCESS, the\n# other feeds still finish, and the execution fails at the end.\n#\n# Configuration comes from environment variables set by Terraform:\n#   SCOPE                 organizations/<id>, folders/<id>, or projects/<id>\n#   BUCKET                data bucket name\n#   CONTENT_TYPES         comma-separated, for example RESOURCE,IAM_POLICY,ORG_POLICY\n#   POLL_TIMEOUT_SECONDS  how long to wait for each export\n#   COLLECTOR_VERSION     recorded in _meta.json\n#\n# Optional argument: {\"read_time\": \"2026-11-10T06:00:00Z\"} for a backfill.\n# Cloud Asset Inventory accepts read times up to 35 days in the past.\n\nmain:\n  params: [args]\n  steps:\n    - init:\n        assign:\n          - started: ${math.floor(sys.now())}\n          # time.format adds microseconds. Drop them so run= reads 20261120T060000Z.\n          - read_time: ${text.substring(time.format(started), 0, 19) + \"Z\"}\n    - read_args:\n        switch:\n          - condition: ${args != null}\n            steps:\n              - override_read_time:\n                  assign:\n                    - read_time: ${default(map.get(args, \"read_time\"), read_time)}\n    - config:\n        assign:\n          - ingest_dt: ${text.substring(time.format(started), 0, 10)}\n          - run: ${text.replace_all(text.replace_all(read_time, \"-\", \"\"), \":\", \"\")}\n          - scope: ${sys.get_env(\"SCOPE\")}\n          - bucket: ${sys.get_env(\"BUCKET\")}\n          - content_types: ${text.split(sys.get_env(\"CONTENT_TYPES\"), \",\")}\n          - poll_timeout: ${int(sys.get_env(\"POLL_TIMEOUT_SECONDS\"))}\n          - version: ${sys.get_env(\"COLLECTOR_VERSION\")}\n          - execution_id: ${sys.get_env(\"GOOGLE_CLOUD_WORKFLOW_EXECUTION_ID\")}\n          - results: {}\n          - failures: []\n    - export_all:\n        parallel:\n          shared: [results, failures]\n          for:\n            value: content_type\n            in: ${content_types}\n            steps:\n              - feed_id:\n                  assign:\n                    - feed: ${\"gcp-cai-\" + text.replace_all(text.to_lower(content_type), \"_\", \"-\")}\n                    - prefix: ${\"raw/\" + feed + \"/ingest_dt=\" + ingest_dt + \"/run=\" + run}\n              - export_feed:\n                  try:\n                    steps:\n                      - run_export:\n                          call: export_feed\n                          args:\n                            feed: ${feed}\n                            prefix: ${prefix}\n                            content_type: ${content_type}\n                            scope: ${scope}\n                            bucket: ${bucket}\n                            read_time: ${read_time}\n                            poll_timeout: ${poll_timeout}\n                            version: ${version}\n                            execution_id: ${execution_id}\n                          result: meta\n                      - record_result:\n                          assign:\n                            - results[feed]: ${prefix}\n                  except:\n                    as: e\n                    steps:\n                      - record_failure:\n                          assign:\n                            - failure:\n                                feed: ${feed}\n                                error: ${e}\n                            - failures: ${list.concat(failures, failure)}\n    - check_failures:\n        switch:\n          - condition: ${len(failures) > 0}\n            raise:\n              message: \"One or more feeds failed\"\n              failures: ${failures}\n              succeeded: ${results}\n    - done:\n        return:\n          read_time: ${read_time}\n          feeds: ${results}\n\nexport_feed:\n  params: [feed, prefix, content_type, scope, bucket, read_time, poll_timeout, version, execution_id]\n  steps:\n    - start_export:\n        try:\n          call: http.post\n          args:\n            url: ${\"https://cloudasset.googleapis.com/v1/\" + scope + \":exportAssets\"}\n            auth:\n              type: OAuth2\n            body:\n              readTime: ${read_time}\n              contentType: ${content_type}\n              outputConfig:\n                gcsDestination:\n                  uriPrefix: ${\"gs://\" + bucket + \"/\" + prefix + \"/data\"}\n          result: started\n        retry: ${http.default_retry}\n    - set_deadline:\n        assign:\n          - operation: ${started.body.name}\n          - deadline: ${sys.now() + poll_timeout}\n    - wait:\n        call: sys.sleep\n        args:\n          seconds: 10\n    - get_operation:\n        try:\n          call: http.get\n          args:\n            url: ${\"https://cloudasset.googleapis.com/v1/\" + operation}\n            auth:\n              type: OAuth2\n          result: op\n        retry: ${http.default_retry}\n    - check_done:\n        switch:\n          - condition: ${map.get(op.body, \"done\") == true}\n            next: check_error\n          - condition: ${sys.now() > deadline}\n            raise:\n              message: ${\"Export did not finish within \" + string(poll_timeout) + \" seconds\"}\n              operation: ${operation}\n        next: wait\n    - check_error:\n        switch:\n          - condition: ${\"error\" in op.body}\n            raise:\n              message: \"Export failed\"\n              operation: ${operation}\n              error: ${op.body.error}\n    - build_meta:\n        assign:\n          - meta:\n              feed: ${feed}\n              read_time: ${read_time}\n              scope: ${scope}\n              content_type: ${content_type}\n              asset_types: [\"*\"]\n              operation: ${operation}\n              execution_id: ${execution_id}\n              collector: \"cai-export\"\n              collector_version: ${version}\n              objects: ${op.body.response.outputResult.gcsResult.uris}\n    - write_meta:\n        try:\n          call: googleapis.storage.v1.objects.insert\n          args:\n            bucket: ${bucket}\n            name: ${prefix + \"/_meta.json\"}\n            uploadType: media\n            body: ${meta}\n        retry: ${http.default_retry}\n    - write_success:\n        try:\n          call: googleapis.storage.v1.objects.insert\n          args:\n            bucket: ${bucket}\n            name: ${prefix + \"/_SUCCESS\"}\n            uploadType: media\n            body: \"\"\n        retry: ${http.default_retry}\n    - return_meta:\n        return: ${meta}\n","state":"ACTIVE","updateTime":"2026-11-19T16:19:23.30937061Z","userEnvVars":{"BUCKET":"ln-prod-automation-caizen-data","COLLECTOR_VERSION":"0.1.0","CONTENT_TYPES":"RESOURCE,IAM_POLICY,ORG_POLICY","POLL_TIMEOUT_SECONDS":"1800","SCOPE":"organizations/684587186245"}},"location":"us-central1"},"ancestors":["projects/459462137144","folders/133282241538","folders/467357897464","organizations/684587186245"],"update_time":"2026-11-19T16:19:23.321196Z"}
